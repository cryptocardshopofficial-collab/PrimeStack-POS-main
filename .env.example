# ──────────────────────────────────────────────
# PrimeStack Switch — Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=9009
HOST=0.0.0.0
API_PORT=9009
# Local launcher mode: expose the website and both dashboards on separate ports.
MULTI_PORTAL=true
WEBSITE_PORT=9004
MERCHANT_PORT=9005
ADMIN_PORT=9006
DASHBOARD_PORT=9005
DASHBOARD_ORIGIN=http://localhost:9005
MERCHANT_PORTAL_ORIGIN=http://localhost:9005
SERVE_PUBLIC_SITE=false
# Comma-separated trusted proxy IPs/CIDRs. Leave blank when connecting directly.
TRUSTED_PROXIES=
LOG_LEVEL=debug
APP_NAME=primestack-switch

# PostgreSQL
DATABASE_URL=postgresql://primestack:primestack@localhost:5432/primestack?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (admin auth)
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRES_IN=24h

# AES-256-GCM key for encrypted bank account profiles (32 random bytes, base64 encoded).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Store the production value in a secrets manager, never in source control.
BANK_DETAILS_ENCRYPTION_KEY=

# Agent PIN fingerprints and encrypted KYC profiles.
# Generate AGENT_PIN_PEPPER with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Generate AGENT_KYC_ENCRYPTION_KEY with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep both production values in a secrets manager and retain the KYC key for decryption.
AGENT_PIN_PEPPER=
AGENT_KYC_ENCRYPTION_KEY=

# HMAC (API gateway auth)
HMAC_ALGORITHM=sha256
HMAC_HEADER_PREFIX=x-primestack

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,es,ar,pt

# ──────────────────────────────────────────────
# Wise Platform Integration
# Get these from: wise.com/user/account/developer
# ──────────────────────────────────────────────

# API credentials — set these in your local secret store or Render, not in this file.
WISE_API_KEY=
WISE_PROFILE_ID=
WISE_ENV=live
WISE_VIRTUAL_ACCOUNTS_ENABLED=false
WISE_VIRTUAL_ACCOUNT_PROVISIONING_ENABLED=false

# Wise API base URLs (do not change)
WISE_LIVE_URL=

# RSA public key from Wise (sandbox or production, depending on WISE_ENV).
# Store the PEM as one value; use \n for line breaks where required by the secret manager.
WISE_WEBHOOK_PUBLIC_KEY=
WISE_WEBHOOK_URL=


# Which platform account to credit when Wise receives funds
WISE_DEFAULT_CREDIT_ACCOUNT=PLATFORM:RESERVE:USD

# Minimum transfer amount to auto-credit (0 = no minimum)
WISE_MIN_AUTO_CREDIT=0

# ──────────────────────────────────────────────
# Inbound real-funds webhook (POST /webhooks/inbound)
# ──────────────────────────────────────────────

# Shared secret used to verify inbound fund receipts. Leave empty to disable the
# webhook entirely — an unset secret rejects every request.
# Senders sign `${timestamp}${JSON.stringify(body)}` with HMAC-SHA256 and send
# the epoch-millisecond timestamp in x-primestack-timestamp and the hex digest
# in x-primestack-signature.
INBOUND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_MAX_TIMESTAMP_DRIFT_MS=300000

# Ledger account prefix that is debited when external funds are credited
# (ASSET account, created on first use per currency).
INBOUND_FUNDING_ACCOUNT_PREFIX=SYSTEM-FUNDING
