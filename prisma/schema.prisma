// ──────────────────────────────────────────────
// S2S ENGINE — Server-to-Server Payment Engine
// ──────────────────────────────────────────────

enum S2sConnectionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TESTING
}

enum S2sPaymentStatus {
  PENDING
  PROCESSING
  AUTHENTICATED
  COMPLETED
  FAILED
  REVERSED
  EXPIRED
}

enum S2sBankWithdrawalStatus {
  PENDING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// An external server endpoint that this switch can receive funds from.
/// Customers register their server URL, provide an HMAC secret,
/// and optionally define their ledger wallet destination.
model S2sConnection {
  id                 String                @id @default(uuid())
  name               String                // human-readable label
  merchantId         String
  merchant           Merchant              @relation("S2sMerchantConnections", fields: [merchantId], references: [id])
  endpointUrl        String                // remote server base URL to call for fund pulls
  apiSecret          String                @db.Text // encrypted HMAC secret provided by the customer
  apiKeyHeader       String                @default("x-api-key") // header name for the secret
  callbackUrl        String?               // URL we POST receipts to after processing
  status             S2sConnectionStatus   @default(ACTIVE)
  allowedIps         String[]              // IP allowlist for incoming requests from this server
  supportedCurrencies String[]             // e.g. ["USD","EUR","GBP"]
  dailyLimitAmount   Decimal?              @db.Decimal(20, 4)
  singleTxLimitAmount Decimal?             @db.Decimal(20, 4)
  receiptTemplateId  String?               // default receipt template
  receiptTemplate    S2sReceiptTemplate?   @relation(fields: [receiptTemplateId], references: [id])
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  payments           S2sPayment[]
  withdrawals        S2sBankWithdrawal[]

  @@index([merchantId])
  @@index([status])
}

/// A single fund-receive event from an external server.
/// Each payment posts a double-entry journal entry and is linked to
/// the receiving merchant's wallet.
model S2sPayment {
  id                 String           @id @default(uuid())
  reference          String           @unique
  connectionId       String
  connection         S2sConnection    @relation(fields: [connectionId], references: [id])
  merchantId         String
  amount             Decimal          @db.Decimal(20, 4)
  currency           String           @default("USD")
  feeAmount          Decimal          @default(0) @db.Decimal(20, 4)
  netAmount          Decimal          @default(0) @db.Decimal(20, 4)
  senderReference    String?          // reference from the remote server
  senderAccountId    String?          // identifier on the remote server
  receiverWalletAddr String           // destination wallet address in this switch
  journalEntryRef    String?          // linked journal entry reference
  receiptTemplateId  String?
  receiptTemplate    S2sReceiptTemplate? @relation(fields: [receiptTemplateId], references: [id])
  receiptData        Json?            // rendered receipt key-value pairs
  status             S2sPaymentStatus @default(PENDING)
  authenticatedAt    DateTime?
  completedAt        DateTime?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  withdrawals        S2sBankWithdrawal[]

  @@index([connectionId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
  @@index([senderReference])
}

/// A bank withdrawal instruction — moves settled funds from the merchant's
/// internal wallet to an external bank account (SWIFT, ACH, SEPA).
model S2sBankWithdrawal {
  id                 String                    @id @default(uuid())
  reference          String                    @unique
  connectionId       String
  connection         S2sConnection             @relation(fields: [connectionId], references: [id])
  merchantId         String
  paymentId          String?                   // optional — withdrawal from a specific payment
  payment            S2sPayment?               @relation(fields: [paymentId], references: [id])
  walletAddress      String                    // source wallet to debit
  amount             Decimal                   @db.Decimal(20, 4)
  currency           String                    @default("USD")
  feeAmount          Decimal                   @default(0) @db.Decimal(20, 4)
  netAmount          Decimal                   @default(0) @db.Decimal(20, 4)
  // Bank destination details (stored encrypted in production; plain for dev)
  bankName           String
  bankCountry        String
  accountHolderName  String
  iban               String?
  swiftBic           String?
  accountNumber      String?
  routingNumber      String?
  bankAddress        String?
  journalEntryRef    String?
  status             S2sBankWithdrawalStatus   @default(PENDING)
  submittedAt        DateTime?
  completedAt        DateTime?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([connectionId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

/// A JSON-driven receipt template. Customers upload a JSON schema that
/// defines which fields must appear on receipts for this connection.
/// The engine renders incoming payment data against this template.
model S2sReceiptTemplate {
  id           String   @id @default(uuid())
  name         String
  merchantId   String
  description  String?
  // JSON schema defining receipt fields: { fields: [{ key, label, source, required, format }] }
  templateJson Json
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connections  S2sConnection[]
  payments     S2sPayment[]

  @@unique([merchantId, name])
  @@index([merchantId])
}

// ──────────────────────────────────────────────
// PAYMENT RAILS (Wise pass-through)
// ──────────────────────────────────────────────

enum RailsTransactionStatus {
  PROCESSING
  COMPLETED
  FAILED
  UNMATCHED
}

/// A customer registered on the rails: owns a Wise virtual IBAN and a real
/// bank account that incoming funds are forwarded to. The rails never hold a
/// balance — this row is routing metadata only.
model RailsCustomer {
  id                String    @id // "CUST-000001"
  name              String
  email             String
  phone             String?
  wiseIBAN          String?
  wiseAccountNumber String?
  bankDetails       Json
  totalReceived     Decimal   @default(0) @db.Decimal(20, 4)
  transactionCount  Int       @default(0)
  lastTransactionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions RailsTransaction[]

  @@index([email])
  @@index([wiseIBAN])
  @@index([wiseAccountNumber])
}

/// One incoming Wise credit and the payout it triggered. `eventId` is the
/// idempotency key — a webhook replay can never dispatch a second payout.
model RailsTransaction {
  id            String                @id // "RAILS-<ts>-<suffix>"
  eventId       String                @unique
  transferId    String
  status        RailsTransactionStatus @default(PROCESSING)
  customerId    String?
  customer      RailsCustomer?        @relation(fields: [customerId], references: [id])
  inAmount      Decimal?              @db.Decimal(20, 4)
  inCurrency    String?
  senderName    String?
  senderAccount String?
  payoutRef     String?
  payoutStatus  String?
  error         String?
  metadata      Json?
  receivedAt    DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@index([transferId])
  @@index([customerId])
  @@index([receivedAt])
}

// ──────────────────────────────────────────────
// SANCTIONS SCREENING
// ──────────────────────────────────────────────

enum SanctionsListSource {
  OFAC
  UN
  EU
  UK_HMT
  UAE_LOCAL
  INTERNAL
}

enum SanctionsEntityType {
  PERSON
  COMPANY
  BANK
  COUNTRY
}

enum SanctionsScreeningStatus {
  CLEAR
  POTENTIAL_MATCH
  CONFIRMED_MATCH
  FALSE_POSITIVE
}

/// One name on a watchlist (OFAC SDN, UN Consolidated, EU, UK HMT, UAE local).
/// Lists are imported by an operator; nothing is bundled so a deployment can
/// never screen against stale or invented data.
model SanctionsListEntry {
  id          String              @id @default(uuid())
  listSource  SanctionsListSource
  entityType  SanctionsEntityType
  primaryName String
  aliases     String[]            @default([])
  country     String?
  /// For BANK entries: the institution's registered trading name, if it differs.
  bankName    String?
  program     String?
  /// The list's own identifier (OFAC ent_num, UN dataid, etc.) — makes re-import idempotent.
  listRef     String?
  remarks     String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  screenings  SanctionsScreening[]

  @@unique([listSource, listRef])
  @@index([listSource, active])
  @@index([entityType])
  @@index([country])
  @@index([primaryName])
}

/// The result of screening one party. `reference` is caller-supplied and
/// unique, so a retried screen updates the same row instead of duplicating it.
model SanctionsScreening {
  id             String                   @id @default(uuid())
  reference      String                   @unique
  entityType     SanctionsEntityType
  inputName      String
  inputCountry   String?
  bankName       String?
  status         SanctionsScreeningStatus @default(CLEAR)
  score          Int                      @default(0)
  matchedEntryId String?
  matchedEntry   SanctionsListEntry?      @relation(fields: [matchedEntryId], references: [id], onDelete: SetNull)
  matchedName    String?
  matchedList    SanctionsListSource?
  matchDetail    Json?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([inputName])
  @@index([matchedEntryId])
}

// ──────────────────────────────────────────────
// WEBHOOK ORCHESTRATION
// ──────────────────────────────────────────────

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXHAUSTED
}

/// A merchant's subscription to platform events. The signing secret is stored
/// AES-256-GCM encrypted; only the last four characters are ever returned.
model WebhookSubscription {
  id             String          @id @default(uuid())
  ownerType      String          @default("MERCHANT") // MERCHANT, AGENT, SYSTEM
  merchantId     String?
  merchant       Merchant?       @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  eventNames     String[]        @default([])
  callbackUrl    String
  description    String?
  secretCipher   String
  secretLast4    String
  active         Boolean         @default(true)
  maxAttempts    Int             @default(5)
  lastDeliveryAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  deliveries     WebhookDelivery[]

  @@index([active, eventNames])
  @@index([merchantId])
}

/// One attempt-history record per (subscription, event). Retries update the
/// same row, so a delivery can be replayed without creating duplicates.
model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId        String
  eventName      String
  reference      String?
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseCode   Int?
  responseBody   String?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([eventName, createdAt])
  @@index([subscriptionId, createdAt])
}

// ──────────────────────────────────────────────
// PAYMENT INGESTION ORCHESTRATION
// ──────────────────────────────────────────────

/// The rail an incoming payment arrived on.
enum PaymentRail {
  SWIFT_MT103
  SWIFT_MT202
  ISO20022
  ACH
  SEPA
  FEDWIRE
}

/// Lifecycle of an incoming payment through the ingestion pipeline.
enum PaymentStatus {
  RECEIVED
  SCREENING
  SCREENED
  FRAUD_CHECK
  UNDER_REVIEW
  PENDING_ASSIGNMENT
  POSTING
  POSTED
  REJECTED
  FAILED
}

/// A single incoming payment driven through parse → sanctions → fraud →
/// resolve → ledger post → notify. `reference` is unique per rail so a
/// replayed message can never double-post.
model IncomingPayment {
  id                   String        @id @default(uuid())
  reference            String        // SWIFT :20: or caller-supplied idempotency key
  rail                 PaymentRail
  status               PaymentStatus @default(RECEIVED)

  amount               Decimal       @db.Decimal(20, 4)
  currency             String        @default("USD")
  valueDate            String?
  operationCode        String?
  charges              String?

  debtorName           String?
  debtorAccount        String?
  debtorBic            String?
  debtorCountry        String?

  creditorName         String?
  creditorAccount      String?
  creditorBic          String?
  creditorCountry      String?

  merchantId           String?
  merchant             Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  walletId             String?
  wallet               Wallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)
  journalEntryRef      String?

  sanctionsScreeningIds String[]      @default([])
  fraudVerdict         String?
  fraudRiskScore       Int?

  failureReason        String?
  reviewedBy           String?
  reviewNotes          String?

  metadata             Json?
  postedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([rail, reference])
  @@index([status])
  @@index([merchantId])
  @@index([createdAt])
  @@index([creditorAccount])
}

// ──────────────────────────────────────────────
// SUPE — bank-grade outbound settlement instruction.
// Exports ledger data to a bank in a format the bank accepts (ISO 20022
// pain.001, CSV, JSON) and tracks the bank validation/execution lifecycle:
// DRAFT → SUBMITTED → ACCEPTED → EXECUTED (or REJECTED / CANCELLED).
// Status / format / channel are stored as validated strings (Zod-enforced at
// the boundary) so the model can evolve without enum-migration churn.
// ──────────────────────────────────────────────
model SettlementInstruction {
  id                 String   @id @default(uuid())
  reference          String   @unique // SUPE-SI-<short hash>
  status             String   @default("DRAFT") // DRAFT|SUBMITTED|ACCEPTED|EXECUTED|REJECTED|CANCELLED
  format             String   // ISO_20022|CSV|JSON
  channel            String   // BANK_API|SFTP|FILE_UPLOAD|MANUAL
  amount             Decimal  @db.Decimal(20, 4)
  currency           String   @db.VarChar(3)
  valueDate          String? // YYYY-MM-DD settlement / value date
  messageId          String? // ISO 20022 MsgId
  endToEndId         String?
  uetr               String? // end-to-end unique transaction reference
  debtor             Json?   // { name, iban, agentBic, ... }
  creditor           Json?   // { name, iban, agentBic, ... }
  remittanceInfo     String? @db.Text
  sourceJournalRefs  String[] // ledger entries this instruction settles (provenance)
  payload            String? @db.Text // generated file (XML/CSV/JSON)
  bankResponse       Json?
  bankTransactionRef String? // bank-side execution reference
  rejectionReason    String? @db.Text
  submittedAt        DateTime?
  acceptedAt         DateTime?
  executedAt         DateTime?
  merchantId         String?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([merchantId])
  @@index([createdAt])
}

// SUPE inbound bank-feed confirmation tracking. An initiation message
// (pacs.008 / pain.001) creates a PENDING record; a bank confirmation
// (camt.054 credit notification or pacs.002 ACSC) finalises the ledger
// credit. Status / sourceFormat stored as validated strings.
model InboundPayment {
  id              String   @id @default(uuid())
  endToEndId      String   @unique // the bank payment reference to match on
  status          String   @default("PENDING") // PENDING|CONFIRMED|CREDITED|REJECTED
  amount          Decimal? @db.Decimal(20, 4)
  currency        String?  @db.VarChar(3)
  sender          String?
  senderAccount   String?
  sourceFormat    String   // pacs.008|pain.001|camt.054|pacs.002|ISO_20022
  source          String   @default("BANK_FEED") // BANK_FEED|MANUAL
  valueDate       String?
  journalEntryRef String?
  rejectionReason String?
  merchantId      String?
  keyId           String?
  receivedAt      DateTime @default(now())
  confirmedAt     DateTime?
  creditedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([merchantId])
  @@index([createdAt])
}
